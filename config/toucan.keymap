#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define NUM    1
#define FUN    2
#define NAV    3
#define MOUSE  4
#define SYM    5
#define EXTRA  6


/ {
      soft_off_wakers {
          compatible = "zmk,soft-off-wakeup-sources";
          wakeup-sources = <&kscan0>;
      };

      hml: hml {
          compatible = "zmk,behavior-hold-tap";
          label = "HML";
          #binding-cells = <2>;
          bindings = <&kp>, <&kp>;

          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          flavor = "balanced";
          hold-trigger-on-release;
          require-prior-idle-ms = <150>;

          /* All keys on the right half */
          hold-trigger-key-positions = <
              6 7 8 9 10 11
              18 19 20 21 22 23
              30 31 32 33 34 35
              39 40 41
          >;
      };

      hmr: hmr {
          compatible = "zmk,behavior-hold-tap";
          label = "HMR";
          #binding-cells = <2>;
          bindings = <&kp>, <&kp>;

          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          flavor = "balanced";
          hold-trigger-on-release;
          require-prior-idle-ms = <150>;

          /* All keys on the left half */
          hold-trigger-key-positions = <
              0 1 2 3 4 5
              12 13 14 15 16 17
              24 25 26 27 28 29
              36 37 38
          >;
      };
            combos {
          compatible = "zmk,combos";
	            softoff {
              bindings = <&soft_off>;
              key-positions = <1 14 25>;
          };


          caps_word {
              bindings = <&caps_word>;
              key-positions = <17 18>;
              require-prior-idle-ms = <150>;
              timeout-ms = <40>;
          };
      };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp GRAVE       &kp Q        &kp W        &kp E         &kp R          &kp T             &kp Y          &kp U          &kp I          &kp O         &kp P           &kp BACKSPACE
                &kp TAB         &hml LCMD A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &kp G             &kp H          &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RCMD SEMI  &kp APOS
                &kp LEFT_SHIFT  &kp Z        &kp X        &kp C         &kp V          &kp B             &kp N          &kp M          &kp COMMA      &kp DOT       &kp FSLH        &kp CAPS
                                           &mt LCTRL ESCAPE  &mo SYM  &lt NUM ENTER    &lt FUN SPACE  &lt NAV F20  &lt EXTRA LC(B)
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &none  &none     &none     &none      &none       &none              &kp PLUS   &kp N7  &kp N8  &kp N9  &kp N0    &kp BACKSPACE
                &none  &kp LCMD  &kp LALT  &kp LCTRL  &kp LSHIFT  &none              &kp MINUS  &kp N4  &kp N5  &kp N6  &kp LBKT  &kp RBKT
                &none  &none     &none     &none      &none       &none              &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp DOT   &none
                                  &none  &none  &trans              &kp N0  &kp SPACE  &none
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                &none   &none     &none     &none      &none       &none              &none  &kp F7  &kp F8  &kp F9  &kp F12  &none
                &trans  &kp LCMD  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
                &none   &none     &none     &none      &none       &none              &none  &kp F1  &kp F2  &kp F3  &kp F10  &none
                                  &none  &none  &trans              &trans  &trans  &none
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none  &none     &none     &none      &none       &none              &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none  &none
                &none  &kp LCMD  &kp LALT  &kp LCTRL  &kp LSHFT  &none              &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none
                &none  &none     &none     &none      &none       &none              &none     &none      &none      &none      &none  &none
                                  &none  &none  &kp DEL             &none  &trans  &none
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                                &mkp MCLK  &mkp LCLK  &mkp RCLK           &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none  &none      &none     &none      &none      &none              &kp PLUS   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &kp LEFT_BRACKET
                &none  &kp LCMD   &kp LALT  &kp LCTRL  &kp LSHFT  &none              &kp MINUS  &kp DLLR  &kp PRCNT  &kp CARET  &kp LBKT   &kp RBKT
                &none  &kp LC(A)  &none     &none      &none      &none              &kp EQUAL  &kp EXCL  &kp AT     &kp HASH   &kp UNDER  &kp BACKSLASH
                                   &none  &trans  &trans             &trans  &trans  &none
            >;
        };

        extra {
            display-name = "EXTRA";
            bindings = <
                &studio_unlock  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4       &trans  &trans  &trans  &trans  &trans  &kp LEFT_BRACKET
                &kp C_SLEEP     &bt BT_CLR     &trans        &trans         &trans          &trans             &trans  &trans  &trans  &trans  &trans  &trans
                &trans          &kp C_AC_UNDO  &kp C_AC_CUT  &kp C_AC_COPY  &kp C_AC_PASTE  &kp PRINTSCREEN    &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
  &soft_off {
      hold-time-ms = <2000>;
  };
